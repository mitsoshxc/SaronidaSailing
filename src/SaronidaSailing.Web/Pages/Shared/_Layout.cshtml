@using Microsoft.AspNetCore.Antiforgery
@using SaronidaSailing.Web.Content
@using SaronidaSailing.Web.Localization
@inject ICmsEditContext EditContext
@inject IPageContentAccessor ContentAccessor
@inject IAntiforgery Antiforgery
@inject ILocalizedUrlService UrlService
@{
    var isEditor = await EditContext.IsEditorAsync();
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <cms-seo fallback-title="@ViewData["Title"] · Saronida Sailing" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="preload" as="font" type="font/woff2" href="/fonts/commissioner/commissioner-greek.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/commissioner/commissioner-latin.woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (isEditor)
    {
        <link rel="stylesheet" href="~/css/cms-edit.css" asp-append-version="true" />
    }
</head>
<body>
    <a class="skip-link" href="#main">@UiText.SkipLink.Current</a>
    <partial name="_CookieConsent" />
    @if (isEditor)
    {
        <partial name="_AdminToolbar" />
    }
    <partial name="_Header" />
    <main id="main" tabindex="-1">
        @RenderBody()
    </main>
    <partial name="_Footer" />
    <button type="button" class="to-top" data-to-top hidden aria-label="@UiText.BackToTop.Current">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 19V5M6 11l6-6 6 6"></path></svg>
    </button>
    @if (isEditor)
    {
        var config = CmsEditorConfig.Create(
            await ContentAccessor.GetAsync(),
            Antiforgery.GetAndStoreTokens(Context).RequestToken!,
            UrlService.GetCurrentPage());
        <script type="application/json" id="cms-config">@Html.Raw(config.ToJson())</script>
        <script type="module" src="~/js/cms-edit.js" asp-append-version="true"></script>
    }
    <script type="module" src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
