@page "/admin/login"
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<h1>Log in</h1>

<form method="post">
    @if (Model.Error is not null)
    {
        <p id="error" class="admin-error" role="alert">@Model.Error</p>
    }
    <div class="admin-field">
        <label for="Email">Email</label>
        <input id="Email" name="Email" type="email" autocomplete="username" required value="@Model.Email"
               aria-describedby="@(Model.Error is null ? null : "error")" aria-invalid="@(Model.Error is null ? null : "true")" />
    </div>
    <div class="admin-field">
        <label for="Password">Password</label>
        <input id="Password" name="Password" type="password" autocomplete="current-password" required
               aria-describedby="@(Model.Error is null ? null : "error")" aria-invalid="@(Model.Error is null ? null : "true")" />
    </div>
    <button type="submit" class="admin-button">Log in</button>
</form>
