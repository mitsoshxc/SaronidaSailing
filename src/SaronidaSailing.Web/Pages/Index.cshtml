@page
@using System.Globalization
@using SaronidaSailing.Web.Localization
@model IndexModel
@inject ILocalizedUrlService UrlService
@{
    ViewData["Title"] = "Home";
    var locale = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == SiteCultures.English
        ? SiteCultures.English
        : SiteCultures.Greek;
    var tripsPath = UrlService.GetPath("trips", locale);
    var boatPath = UrlService.GetPath("boat", locale);
    var contactPath = UrlService.GetPath("contact", locale);
    var tripDay = tripsPath + "?trip=day";
    var tripIslands = tripsPath + "?trip=islands";
    var tripWeek = tripsPath + "?trip=week";
}

<section class="section section--dark hero" cms-section="home.hero" cms-section-label="Hero">
    <div class="wrap hero__inner">
        <div class="hero__text">
            <p class="eyebrow" cms="home.hero.eyebrow"></p>
            <h1 class="h1--hero" cms="home.hero.title"></h1>
            <p class="lead" cms="home.hero.lead"></p>
            <div class="hero__actions">
                <a class="btn btn--cta" href="@tripDay"><span cms="home.hero.cta-trips"></span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
                <a class="btn btn--outline" href="@boatPath"><span cms="home.hero.cta-boat"></span></a>
            </div>
        </div>
        <div class="hero__media media-frame">
            <svg class="hero__art" viewBox="0 0 358 300" preserveAspectRatio="xMidYMid slice" role="img" aria-label="@UiText.HeroIllustration.Current" focusable="false">
                <circle cx="272" cy="118" r="30" fill="#E8875F" opacity="0.9"></circle>
                <rect x="0" y="212" width="358" height="88" fill="#0F4560"></rect>
                <path d="M252 226 H292 M258 238 H286 M264 250 H280" stroke="#E8875F" stroke-width="2" stroke-linecap="round" opacity="0.55"></path>
                <path d="M20 256 q10 -6 20 0 t20 0 M120 272 q10 -6 20 0 t20 0 M296 268 q10 -6 20 0 t20 0" stroke="#3B7895" stroke-width="2" fill="none" stroke-linecap="round"></path>
                <path d="M60 204 L304 204 L294 216 L72 216 Z" fill="#C9D7DE"></path>
                <path d="M50 200 L300 200 L290 214 L64 214 Z" fill="#F4F7F8"></path>
                <path d="M96 200 L110 180 L238 180 L262 200 Z" fill="#F4F7F8"></path>
                <path d="M118 190 H228" stroke="#123447" stroke-width="5" stroke-linecap="round"></path>
                <path d="M150 180 L156 167 L216 167 L222 180" stroke="#F4F7F8" stroke-width="3" fill="none" stroke-linejoin="round"></path>
                <path d="M172 167 V30" stroke="#F4F7F8" stroke-width="3" stroke-linecap="round"></path>
                <path d="M176 34 Q216 96 238 163 L176 163 Z" fill="#F4F7F8" opacity="0.92"></path>
                <path d="M168 40 L72 198 L168 176 Z" fill="#DCE7EC" opacity="0.88"></path>
            </svg>
            <cms-image key="home.hero.image" label="Hero photo" sizes="(min-width: 960px) 50vw, 100vw" alt-source="home.hero.title" loading="eager" class="media-frame__img" />
        </div>
    </div>
</section>

<section class="section--soft glance" cms-section="home.glance" cms-section-label="At a glance">
    <div class="wrap">
        <h2 class="visually-hidden" cms="home.glance.title"></h2>
        <ul class="stat-grid glance__grid">
            <li class="stat" cms-list="home.glance-stats" cms-add-label="Add stat"><span class="stat__value" cms-field="value"></span><span class="stat__label" cms-field="label"></span></li>
        </ul>
    </div>
</section>

<section class="section trips" cms-section="home.trips" cms-section-label="Trips teaser">
    <div class="wrap">
        <div class="section-head">
            <div class="section-head__text">
                <p class="eyebrow" cms="home.trips.eyebrow"></p>
                <h2 cms="home.trips.title"></h2>
            </div>
            <a class="section-head__link" href="@tripsPath">@UiText.AllTrips.Current<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        </div>
        <div class="trip-grid">
            <article class="trip-card" cms-section="home.trip-day" cms-section-label="Day cruise card">
                <div class="trip-card__media media-frame media-placeholder">
                    <cms-image key="home.trip-day.image" label="Day cruise photo" sizes="(min-width: 960px) 33vw, 100vw" alt-source="home.trip-day.title" class="media-frame__img" />
                </div>
                <div class="trip-card__body">
                    <div class="trip-card__chips">
                        <span class="chip" cms="home.trip-day.duration"></span>
                        <span class="chip" cms="home.trip-day.when"></span>
                    </div>
                    <h3 id="home-trip-day-title" cms="home.trip-day.title"></h3>
                    <p class="trip-card__text" cms="home.trip-day.text"></p>
                    <div class="trip-card__foot">
                        <span class="trip-card__price">@UiText.From.Current <strong cms="home.trip-day.price"></strong></span>
                        <a class="btn btn--dark" href="@tripDay" aria-describedby="home-trip-day-title">@UiText.Details.Current<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
                    </div>
                </div>
            </article>
            <article class="trip-card" cms-section="home.trip-islands" cms-section-label="Islands card">
                <div class="trip-card__media media-frame media-placeholder">
                    <cms-image key="home.trip-islands.image" label="Islands photo" sizes="(min-width: 960px) 33vw, 100vw" alt-source="home.trip-islands.title" class="media-frame__img" />
                </div>
                <div class="trip-card__body">
                    <div class="trip-card__chips">
                        <span class="chip" cms="home.trip-islands.duration"></span>
                        <span class="chip" cms="home.trip-islands.when"></span>
                    </div>
                    <h3 id="home-trip-islands-title" cms="home.trip-islands.title"></h3>
                    <p class="trip-card__text" cms="home.trip-islands.text"></p>
                    <div class="trip-card__foot">
                        <span class="trip-card__price">@UiText.From.Current <strong cms="home.trip-islands.price"></strong></span>
                        <a class="btn btn--dark" href="@tripIslands" aria-describedby="home-trip-islands-title">@UiText.Details.Current<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
                    </div>
                </div>
            </article>
            <article class="trip-card" cms-section="home.trip-week" cms-section-label="Weekly charter card">
                <div class="trip-card__media media-frame media-placeholder">
                    <cms-image key="home.trip-week.image" label="Weekly charter photo" sizes="(min-width: 960px) 33vw, 100vw" alt-source="home.trip-week.title" class="media-frame__img" />
                </div>
                <div class="trip-card__body">
                    <div class="trip-card__chips">
                        <span class="chip" cms="home.trip-week.duration"></span>
                        <span class="chip" cms="home.trip-week.when"></span>
                    </div>
                    <h3 id="home-trip-week-title" cms="home.trip-week.title"></h3>
                    <p class="trip-card__text" cms="home.trip-week.text"></p>
                    <div class="trip-card__foot">
                        <span class="trip-card__price">@UiText.From.Current <strong cms="home.trip-week.price"></strong></span>
                        <a class="btn btn--dark" href="@tripWeek" aria-describedby="home-trip-week-title">@UiText.Details.Current<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>

<section class="section section--dark boat" cms-section="home.boat" cms-section-label="Boat teaser">
    <div class="wrap boat__inner">
        <div class="boat__head">
            <p class="eyebrow" cms="home.boat.eyebrow"></p>
            <h2 cms="home.boat.title"></h2>
        </div>
        <div class="boat__media media-frame media-placeholder">
            <cms-image key="home.boat.image" label="Boat photo" sizes="(min-width: 960px) 50vw, 100vw" alt-source="home.boat.title" class="media-frame__img" />
        </div>
        <div class="boat__body">
            <p class="lead" cms="home.boat.text"></p>
            <ul class="stat-grid boat__specs">
                <li class="stat" cms-list="home.boat-specs" cms-add-label="Add spec"><span class="stat__value" cms-field="value"></span><span class="stat__label" cms-field="label"></span></li>
            </ul>
            <div>
                <a class="btn btn--light" href="@boatPath"><span cms="home.boat.cta"></span><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
            </div>
        </div>
    </div>
</section>

<section class="section section--soft why" cms-section="home.why" cms-section-label="Why with a skipper">
    <div class="wrap">
        <div class="section-head">
            <div class="section-head__text">
                <p class="eyebrow" cms="home.why.eyebrow"></p>
                <h2 cms="home.why.title"></h2>
            </div>
        </div>
        <ul class="why-grid">
            <li class="why-item" cms-list="home.why-items" cms-add-label="Add reason">
                <span class="icon-badge why-item__icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 3l7 3v5c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V6z"></path><path d="M9 12l2 2 4-4"></path></svg></span>
                <span class="why-item__body"><strong class="why-item__title" cms-field="title"></strong><span class="why-item__text" cms-field="text"></span></span>
            </li>
        </ul>
    </div>
</section>

<vc:instagram-feed></vc:instagram-feed>

<section class="departure" cms-section="home.departure" cms-section-label="Departure point">
    <div class="wrap departure__inner">
        <div class="departure__info">
            <span class="icon-badge" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span>
            <div class="departure__text" cms="home.departure.text" cms-rich></div>
        </div>
        <a class="btn btn--outline" href="@contactPath"><span cms="home.departure.cta"></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    </div>
</section>

<div class="sticky-book" cms-section="home.sticky" cms-section-label="Sticky booking bar">
    <div class="sticky-book__price">
        <span class="sticky-book__label" cms="home.sticky.label"></span>
        <strong cms="home.trip-day.price"></strong>
    </div>
    <a class="btn btn--cta" href="@tripDay">@UiText.Dates.Current</a>
</div>
