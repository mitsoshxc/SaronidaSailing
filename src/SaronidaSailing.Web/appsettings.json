{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Audit": "Information"
    }
  },
  "Logs": {
    "Path": "/var/saronida/logs"
  },
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "auditFile": {
        "type": "File",
        "fileName": "${var:logDir}/audit-${shortdate}.log",
        "layout": "${date:universalTime=true:format=o}|${message}",
        "keepFileOpen": false,
        "maxArchiveDays": 90
      },
      "appFile": {
        "type": "File",
        "fileName": "${var:logDir}/app-${shortdate}.log",
        "layout": "${date:universalTime=true:format=o}|${level:uppercase=true}|${logger}|${message}${onexception:inner=|${exception:format=tostring}}",
        "keepFileOpen": false,
        "maxArchiveDays": 90
      },
      "console": {
        "type": "Console",
        "layout": "${date:universalTime=true:format=o}|${level:uppercase=true}|${logger}|${message}${onexception:inner=|${exception:format=tostring}}"
      }
    },
    "rules": [
      { "logger": "Audit", "minLevel": "Info", "writeTo": "auditFile", "final": true },
      { "logger": "Microsoft.Hosting.Lifetime", "minLevel": "Info", "maxLevel": "Info", "writeTo": "console", "final": true },
      { "logger": "Microsoft.*,System.*,Hangfire.*", "maxLevel": "Info", "final": true },
      { "logger": "*", "minLevel": "Warn", "writeTo": "appFile,console" }
    ]
  },
  "ConnectionStrings": {
    "Content": "Host=postgres;Port=5432;Database=saronida;Username=saronida"
  },
  "DataProtection": {
    "KeysPath": "/var/saronida/data/keys"
  },
  "Media": {
    "RootPath": "/var/saronida/media"
  },
  "Health": {
    "HomePageUrl": "http://127.0.0.1:8080/"
  },
  "ForwardedHeaders": {
    "KnownNetworks": [ "172.30.0.0/24" ]
  },
  "AllowedHosts": "*"
}
