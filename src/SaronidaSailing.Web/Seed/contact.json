      "type": "text",
      "el": "Επικοινωνία",
      "en": "Contact"
    },
    "contact.intro.title": {
      "type": "text",
      "el": "Μιλήστε μας απευθείας",
      "en": "Talk to us directly"
    },
    "contact.intro.lead": {
      "type": "text",
      "el": "Χωρίς φόρμες και αναμονή. Πάρτε τηλέφωνο, στείλτε email ή μήνυμα στο Instagram, όπως σας βολεύει.",
      "en": "No forms and no waiting. Call us, send an email or message us on Instagram, whichever suits you."
    },
    "contact.intro.phone-label": {
      "type": "text",
      "el": "Καλέστε μας",
      "en": "Call us"
    },
    "contact.intro.phone-2-label": {
      "type": "text",
      "el": "Δεύτερο τηλέφωνο",
      "en": "Second phone"
    },
    "contact.intro.email-label": {
      "type": "text",
      "el": "Στείλτε email",
      "en": "Send an email"
    },
    "contact.intro.instagram-label": {
      "type": "text",
      "el": "Μήνυμα στο Instagram",
      "en": "Message on Instagram"
    },
    "contact.intro.instagram": {
