    "contact.seo.title": {
      "type": "text",
      "el": "Επικοινωνία · Saronida Sailing",
      "en": "Contact · Saronida Sailing"
    },
    "contact.seo.description": {
      "type": "text",
      "el": "Καλέστε μας, στείλτε email ή μήνυμα στο Instagram. Θα μας βρείτε στο λιμάνι του Αγίου Νικολάου, στην Ανάβυσσο.",
      "en": "Call us, send an email or message us on Instagram. You will find us at Agios Nikolaos harbour in Anavyssos."
    },
