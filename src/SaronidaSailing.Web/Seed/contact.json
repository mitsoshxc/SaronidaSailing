      "type": "text",
      "el": "Πού θα μας βρείτε",
      "en": "Where to find us"
    },
    "contact.where.title": {
      "type": "text",
      "el": "Λιμάνι Αγίου Νικολάου",
      "en": "Agios Nikolaos harbour"
    },
    "contact.where.text": {
      "type": "text",
      "el": "Ανάβυσσος, Αττική, στον παραλιακό δρόμο προς το Σούνιο.",
      "en": "Anavyssos, Attica, on the coastal road towards Sounion."
    },
    "contact.where.directions": {
      "type": "link",
      "url": "https://maps.app.goo.gl/UPT73MuDqkViH82M9",
      "el": "Οδηγίες στον χάρτη",
      "en": "Directions on the map"
    },
    "contact.map.image-alt": {
      "type": "text",
      "el": "Χάρτης: λιμάνι Αγίου Νικολάου, Ανάβυσσος",
      "en": "Map: Agios Nikolaos harbour, Anavyssos"
    },
    "contact.map.notice": {
      "type": "text",
      "el": "Ο χάρτης της Google φορτώνει μόνο με τη συναίνεσή σας.",
      "en": "The Google map loads only with your consent."
    },
