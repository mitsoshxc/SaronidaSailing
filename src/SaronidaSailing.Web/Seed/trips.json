  "fields": {
    "trips.seo.title": {
      "type": "text",
      "el": "Εκδρομές με καταμαράν και κράτηση · Saronida Sailing",
      "en": "Catamaran trips and booking · Saronida Sailing"
    },
    "trips.seo.description": {
      "type": "text",
      "el": "Ημερήσια κρουαζιέρα στο Σούνιο, νησιά του Σαρωνικού σε 2–3 ημέρες ή εβδομαδιαία ναύλωση με σκίπερ. Δείτε τι περιλαμβάνεται και κλείστε ημερομηνία.",
      "en": "A day cruise to Sounion, the Saronic islands in 2–3 days or a weekly charter with skipper. See what's included and book a date."
    },
    "trips.intro.eyebrow": {
      "type": "text",
      "el": "Εκδρομές",
      "en": "Trips"
    },
    "trips.intro.title": {
      "type": "text",
      "el": "Διαλέξτε την εκδρομή σας",
      "en": "Choose your trip"
    },
    "trips.intro.lead": {
      "type": "text",
      "el": "Όλες οι εκδρομές είναι ιδιωτικές, με σκίπερ στο σκάφος. Διαλέξτε μία και κλείστε ημερομηνία στον ιστότοπο του συνεργάτη μας.",
      "en": "Every trip is private, with a skipper on board. Pick one and book a date on our partner's website."
    },
    "trips.day.title": {
      "type": "text",
      "el": "Ημερήσια κρουαζιέρα στο Σούνιο",
      "en": "Day cruise to Sounion"
    },
    "trips.day.text": {
      "type": "text",
      "el": "6 ώρες στην Αθηναϊκή Ριβιέρα: απομονωμένοι όρμοι, κολύμπι, σνόρκελ και ο Ναός του Ποσειδώνα από τη θάλασσα.",
      "en": "6 hours on the Athens Riviera: secluded coves, swimming, snorkelling and the Temple of Poseidon seen from the sea."
    },
    "trips.day.included-title": {
      "type": "text",
      "el": "Περιλαμβάνονται",
      "en": "Included"
    },
    "trips.day.excluded-title": {
      "type": "text",
      "el": "Δεν περιλαμβάνονται",
      "en": "Not included"
    },
    "trips.day.capacity": {
      "type": "text",
      "el": "Ιδιωτικό σκάφος, έως [ΑΡ. ΑΤΟΜΩΝ] άτομα",
      "en": "Private boat, up to [MAX] people"
    },
    "trips.islands.title": {
      "type": "text",
      "el": "Νησιά σε 2–3 ημέρες",
      "en": "Islands in 2–3 days"
    },
    "trips.islands.text": {
      "type": "text",
      "el": "Κοιμηθείτε στο σκάφος και ξυπνήστε σε καινούργιο όρμο. Διαλέξτε διαδρομή και ο σκίπερ την προσαρμόζει στον καιρό.",
      "en": "Sleep on board and wake up in a new cove. Choose a route and the skipper adapts it to the weather."
    },
    "trips.islands.pack-title": {
      "type": "text",
      "el": "Ταξιδέψτε ελαφριά",
      "en": "Travel light"
    },
    "trips.islands.capacity": {
      "type": "text",
      "el": "Έως [ΑΡ. ΑΤΟΜΩΝ] άτομα",
      "en": "Up to [MAX] people"
    },
    "trips.week.title": {
      "type": "text",
      "el": "Εβδομαδιαία ναύλωση με σκίπερ",
      "en": "Weekly charter with skipper"
    },
    "trips.week.text": {
      "type": "text",
      "el": "Όλο το Lagoon 500 για μία εβδομάδα ή περισσότερο. Σχεδιάστε τα νησιά με τον σκίπερ πριν έρθετε ή αποφασίστε μέρα με τη μέρα.",
      "en": "The whole Lagoon 500 for a week or longer. Plan the islands with the skipper before you arrive, or decide day by day."
    },
    "trips.week.note": {
      "type": "text",
      "el": "Επιβίβαση Σάββατο 10:00, αποβίβαση 17:00 στον Άγιο Νικόλαο. [Ημέρες προς επιβεβαίωση]",
      "en": "Boarding Saturday 10:00, disembarking 17:00 at Agios Nikolaos. [Days to be confirmed]"
    },
    "trips.booking.title": {
      "type": "text",
