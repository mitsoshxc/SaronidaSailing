    "trips.booking.text": {
      "type": "text",
      "el": "Τη διαθεσιμότητα και την ασφαλή πληρωμή τις αναλαμβάνουν οι συνεργάτες κρατήσεων. Διαλέξτε όποιον χρησιμοποιείτε ήδη.",
      "en": "Our booking partners handle availability and secure payment. Choose whichever you already use."
    },
